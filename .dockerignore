**/.env.*.local
api/.env.local.php

.git
.idea
docs
*.iml

api/vendor
api/var
api/.phpunit.cache

web/node_modules
web/dist
web/.vite
web/*.tsbuildinfo

# Not needed at runtime
api/tests
api/phpunit.dist.xml
